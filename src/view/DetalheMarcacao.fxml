<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.DetalheMarcacaoController"
            prefWidth="340" prefHeight="520"
            style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 2;">
    <top>
        <Label fx:id="tituloLabel" text="Detalhes da Marcação"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 18 0 8 0; -fx-text-fill: #34495e;"
               BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <VBox alignment="TOP_LEFT" spacing="18" style="-fx-padding: 18 32 18 32;">
            <Label fx:id="nomeLabel" text="Nome: " style="-fx-font-size: 15px;"/>
            <Label fx:id="telefoneLabel" text="Telefone: " style="-fx-font-size: 15px;"/>
            <Label fx:id="duracaoLabel" text="Duração: " style="-fx-font-size: 15px;"/>
            <Label fx:id="observacoesLabel" text="Observações: " style="-fx-font-size: 15px;"/>
        </VBox>
    </center>
</BorderPane>