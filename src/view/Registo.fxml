<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="stackPaneRoot" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.RegistoController"
           style="-fx-background-color: lightskyblue;" alignment="CENTER">
    <VBox spacing="12" alignment="CENTER" style="-fx-padding: 40 0 40 0;">
        <Label text="REGISTO"
               style="-fx-font-size: 48px; -fx-font-weight: 900;"/>
        <Label fx:id="errorLabel" textFill="red" visible="false"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER">
            <Label text="Nome:" minWidth="80" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <TextField fx:id="nomeField" prefWidth="160" maxWidth="160" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER">
            <Label text="Password:" minWidth="80" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField" prefWidth="160" maxWidth="160" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
        <Button fx:id="registoBtn" text="Registar" onAction="#handleRegisto" maxWidth="120"
                style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    </VBox>
</StackPane>