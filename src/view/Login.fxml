<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.LoginController"
           alignment="CENTER"
           style="-fx-background-color: lightskyblue;">
    <VBox spacing="8" alignment="CENTER" style="-fx-padding: 40 0 40 0;">
        <Label text="LOGIN"
               style="-fx-font-size: 56px; -fx-font-weight: 900; -fx-padding: 0 0 2 0;"/>
        <Label fx:id="errorLabel" textFill="red" visible="false"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"
               text="Utilizador ou password incorretos"/>
        <HBox spacing="10" alignment="CENTER">
            <Label text="Username:" minWidth="80"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <TextField fx:id="usernameField" prefWidth="160" maxWidth="160"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER">
            <Label text="Password:" minWidth="80"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField" prefWidth="160" maxWidth="160"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
        <Button text="Entrar" onAction="#handleLogin" maxWidth="120"
                style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    </VBox>
</StackPane>