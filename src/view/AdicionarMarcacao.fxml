<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.AdicionarMarcacaoController"
            prefWidth="340" prefHeight="520"
            style="-fx-background-color: rgb(15, 14, 14); -fx-border-width: 0;">
    <top>
        <Label fx:id="tituloLabel" text="Marcação para dia ..." 
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 18 0 8 0; -fx-text-fill: white;"
               BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" spacing="14" style="-fx-padding: 8 24 8 24;">
            <!-- Pesquisa Cliente -->
            <TextField fx:id="pesquisaClienteField" promptText="Pesquisar cliente..." maxWidth="Infinity"
                       style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-width: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"/>
            <ListView fx:id="sugestoesList" maxHeight="80" maxWidth="Infinity" visible="false" managed="false"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-width: 0; -fx-padding: 3.5; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"/>
            <CheckBox fx:id="desconhecidoCheck" text="Desconhecido" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"/>
            
            <!-- Campos para desconhecido -->
            <HBox alignment="CENTER_LEFT">
                <Label text="Nome:" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            </HBox>
            <TextField fx:id="nomeDesconhecidoField" promptText="Nome" disable="true"
                       style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-width: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"/>
            <HBox alignment="CENTER_LEFT">
                <Label text="Telefone:" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            </HBox>
            <TextField fx:id="numeroDesconhecidoField" promptText="Número de telefone" disable="true"
                       style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-width: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"/>
            
            <!-- Campos de marcação -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Duração:" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                <ComboBox fx:id="duracaoCombo" promptText="Duração" maxWidth="70" style="-fx-background-color: white; -fx-background-radius: 12; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"/>
            </HBox>
            <Label fx:id="duracaoErrorLabel" text="" style="-fx-text-fill: rgb(128, 26, 15); -fx-font-size: 13px;" visible="false" managed="false"/>
            
            <HBox alignment="CENTER_LEFT">
                <Label text="Observações:" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            </HBox>
            <TextArea fx:id="observacoesArea" promptText="Observações (opcional)" prefRowCount="3" wrapText="true"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-width: 0; -fx-padding: 2.5; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"/>
            
            <Label fx:id="geralErrorLabel" text="" style="-fx-text-fill: rgb(128, 26, 15); -fx-font-size: 13px;" visible="false" managed="false"/>
            
            <Region minHeight="18"/>
            <HBox spacing="18" alignment="CENTER" style="-fx-padding: 0 0 12 0;">
                <Button fx:id="btnSalvar" text="Salvar" style="-fx-background-color: rgb(36, 43, 141); -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 90px; -fx-pref-height: 36px;" defaultButton="true"/>
                <Button fx:id="btnSair" text="Sair" style="-fx-background-color: rgb(128, 26, 15); -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 90px; -fx-pref-height: 36px;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>