<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.PaginaPrincipalController"
            style="-fx-background-color: #f0f0f0;">
    
    <!-- Área Superior com informações do usuário e navegação -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Label text="App Agenda" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
            <Button text="Logout" onAction="#handleLogout" 
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    
    <!-- Área Principal dividida em 3 colunas -->
    <center>
        <HBox spacing="5" style="-fx-padding: 10;">
            
            <!-- Área Lateral Esquerda -->
            <VBox prefWidth="200" spacing="12" alignment="TOP_CENTER"
                  style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 2; -fx-padding: 10;">
                <ToggleButton fx:id="calendarioToggle" text="Calendário" selected="true" onAction="#mostrarCalendario"
                              maxWidth="Infinity" minHeight="40"
                              style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                <ToggleButton fx:id="clientesToggle" text="Clientes" onAction="#mostrarClientes"
                              maxWidth="Infinity" minHeight="40"
                              style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                <VBox 
                    fx:id="anotacoesBox"
                    spacing="8"
                    style="
                        -fx-background-color: white;
                        -fx-border-color: #bdc3c7;
                        -fx-border-width: 2;
                        -fx-background-radius: 12;
                        -fx-border-radius: 12;
                        -fx-padding: 16;
                        -fx-effect: dropshadow(gaussian, #bbb, 8, 0.2, 0, 2);"
                    VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Anotações"
                            style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="blurToggleBtn"
                                text="🚫"
                                minWidth="28" minHeight="22" maxWidth="28" maxHeight="22"
                                style="-fx-background-radius: 12; -fx-background-color: #e0e0e0; -fx-font-size: 13px; -fx-padding: 0 6 0 6;"/>
                    </HBox>
                    <Separator
                        prefHeight="1"
                        style="-fx-background-color: #e0e0e0;"
                        maxWidth="Infinity"
                        prefWidth="Infinity"/>
                    <TextArea
                        fx:id="anotacoesArea"
                        promptText="Escreva suas anotações aqui..."
                        wrapText="true"
                        style="-fx-font-size: 14px; -fx-background-radius: 12; -fx-border-radius: 8; -fx-background-insets: 0; -fx-border-width: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"
                        VBox.vgrow="ALWAYS"
                        maxWidth="Infinity"
                        prefWidth="Infinity"/>
                </VBox>
            </VBox>
            
            <!-- Área Central - Calendário Semanal -->
            <StackPane fx:id="stackCentral" HBox.hgrow="ALWAYS">
                <VBox fx:id="areaCentral" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 2; -fx-padding: 10;">
                    <!-- Cabeçalho da semana -->
                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 10 0;">
                        <Button fx:id="todayBtn" text="Hoje" onAction="#handleToday" 
                                style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Button fx:id="semanaAnteriorBtn" text="◀" onAction="#semanaAnterior" 
                                style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Button fx:id="proximaSemanaBtn" text="▶" onAction="#proximaSemana" 
                                style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="semanaLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ToggleButton fx:id="diaToggle" text="Dia"/>
                        <ToggleButton fx:id="semanaToggle" text="Semana" selected="true"/>
                        <ToggleButton fx:id="mesToggle" text="Mês"/>
                    </HBox>
                
                    <!-- Grade do calendário -->
                    <ScrollPane fx:id="scrollPaneCalendario" fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-focus-color: transparent; -fx-faint-color: transparent; -fx-background-insets: 0;">
                        <GridPane fx:id="calendarioGrid" hgap="1" vgap="1" 
                                  style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7;"/>
                    </ScrollPane>                
                </VBox>
                <StackPane fx:id="areaClientes" visible="false" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 2; -fx-padding: 10;">
                    <VBox fx:id="clientesContent" alignment="TOP_LEFT" spacing="16" StackPane.alignment="TOP_LEFT" VBox.vgrow="ALWAYS"/>
                </StackPane>
            </StackPane>

            <!-- Área Lateral Direita -->
            <VBox prefWidth="200" spacing="24" style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 2; -fx-padding: 10;">
                <Label text="Clientes Pendentes" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-alignment: center;"/>
                <VBox
                    fx:id="caixaClientesPendentes"
                    spacing="0"
                    alignment="TOP_LEFT"
                    prefHeight="350"
                    style="
                        -fx-background-color: white;
                        -fx-border-color: #bdc3c7;
                        -fx-border-width: 2;
                        -fx-background-radius: 12;
                        -fx-border-radius: 12;
                        -fx-padding: 16;
                        -fx-effect: dropshadow(gaussian, #bbb, 8, 0.2, 0, 2);
                        "
                    VBox.vgrow="ALWAYS"
                />
                <Region VBox.vgrow="ALWAYS"/>
                <Label fx:id="relogioLabel"
                       style="-fx-font-size: 40px; -fx-font-weight: 900; -fx-text-fill: #34495e; -fx-alignment: center;"
                       alignment="CENTER"
                       prefWidth="200"
                />
                <Region VBox.vgrow="ALWAYS"/>
            </VBox>      
        </HBox>
    </center>
    
</BorderPane>
