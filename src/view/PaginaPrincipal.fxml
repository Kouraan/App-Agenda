<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.PaginaPrincipalController"
            style="-fx-background-color: rgb(60,60,60);">
    
    <!-- Área Superior com informações do usuário e navegação -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: rgb(15, 14, 14); -fx-padding: 10;">
            <Label text="App Agenda" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Button fx:id="logoutBtn" text="Logout" onAction="#handleLogout" 
                    focusTraversable="false"
                    style="-fx-background-color: rgb(128, 26, 15); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    
    <!-- Área Principal dividida em 3 colunas -->
    <center>
        <HBox spacing="5" style="-fx-padding: 10;">
            
            <!-- Área Lateral Esquerda -->
            <VBox prefWidth="200" minWidth="200" maxWidth="200" spacing="12" alignment="TOP_CENTER"
                  style="-fx-background-color: rgb(15, 14, 14); -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-width: 0; -fx-padding: 10;">
                <ToggleButton fx:id="calendarioToggle" text="Calendário" selected="true" onAction="#mostrarCalendario"
                              maxWidth="Infinity" minHeight="40"/>
                <ToggleButton fx:id="clientesToggle" text="Clientes" onAction="#mostrarClientes"
                              maxWidth="Infinity" minHeight="40"/>
                <VBox 
                    fx:id="anotacoesBox"
                    spacing="8"
                    style="
                        -fx-background-color: rgb(43, 40, 40);
                        -fx-border-width: 0;
                        -fx-background-radius: 12;
                        -fx-padding: 16;
                        -fx-effect: dropshadow(gaussian, #222, 8, 0.2, 0, 2);"
                    VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Anotações"
                            style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="blurToggleBtn"
                                text="⛔"
                                minWidth="35" minHeight="25" maxWidth="35" maxHeight="25"
                                style="-fx-background-radius: 12; -fx-background-color: rgb(60, 60, 60); -fx-font-size: 15px; -fx-padding: 0; -fx-text-fill: white;"/>
                    </HBox>
                    <Separator
                        prefHeight="1"
                        style="-fx-background-color: white;"
                        maxWidth="Infinity"
                        prefWidth="Infinity"/>
                    <TextArea
                        fx:id="anotacoesArea"
                        promptText="Escreva suas anotações aqui..."
                        wrapText="true"
                        style="-fx-font-size: 14px; -fx-prompt-text-fill: white; -fx-background-color: rgb(60, 60, 60); -fx-control-inner-background: rgb(60, 60, 60); -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: white; -fx-background-insets: 0; -fx-border-width: 2px; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-highlight-fill: #444; -fx-highlight-text-fill: white;"
                        VBox.vgrow="ALWAYS"
                        maxWidth="Infinity"
                        prefWidth="Infinity"/>
                </VBox>
            </VBox>
            
            <!-- Área Central - Calendário Semanal -->
            <StackPane fx:id="stackCentral" HBox.hgrow="ALWAYS">
                <VBox fx:id="areaCentral" minWidth="600" HBox.hgrow="ALWAYS" style="-fx-background-color:rgb(15, 14, 14); -fx-border-width: 0; -fx-background-radius: 12; -fx-padding: 10;">
                    <!-- Cabeçalho da semana -->
                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 10 0;">
                        <Button fx:id="todayBtn" text="Hoje" onAction="#handleToday" 
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgb(43, 40, 40); -fx-border-width: 0; -fx-background-radius: 12;"/>
                        <Button fx:id="semanaAnteriorBtn" text="◀" onAction="#semanaAnterior" 
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgb(43, 40, 40); -fx-border-width: 0; -fx-background-radius: 12;"/>
                        <Button fx:id="proximaSemanaBtn" text="▶" onAction="#proximaSemana" 
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgb(43, 40, 40); -fx-border-width: 0; -fx-background-radius: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="semanaLabel"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ToggleButton fx:id="diaToggle" text="Dia"
                                      style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgb(43, 40, 40); -fx-border-width: 0; -fx-background-radius: 12;"/>
                        <ToggleButton fx:id="semanaToggle" text="Semana" selected="true"
                                      style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgb(43, 40, 40); -fx-border-width: 0; -fx-background-radius: 12;"/>
                        <ToggleButton fx:id="mesToggle" text="Mês"
                                      style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgb(43, 40, 40); -fx-border-width: 0; -fx-background-radius: 12;"/>
                    </HBox>
                
                    <!-- Grade do calendário -->
                    <ScrollPane fx:id="scrollPaneCalendario" 
                            fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" 
                            style="-fx-focus-color: transparent; -fx-faint-color: transparent; -fx-background-insets: 0; -fx-background-color: transparent;
                                   -fx-padding: 0; -fx-hbar-policy: never; -fx-vbar-policy: never;">
                        <GridPane fx:id="calendarioGrid" hgap="6" vgap="6" 
                                  style="-fx-background-color: rgb(15, 14, 14); -fx-border-width: 0;"
                                  maxWidth="Infinity" maxHeight="Infinity"
                                  GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS"/>
                    </ScrollPane>                
                </VBox>
                <StackPane fx:id="areaClientes" visible="false" 
                    style="-fx-background-color: rgb(15, 14, 14); -fx-border-width: 0; -fx-background-radius: 12; -fx-padding: 10;">
                    <VBox fx:id="clientesContent" 
                        alignment="TOP_LEFT"
                        spacing="16"
                        StackPane.alignment="TOP_LEFT"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: rgb(15, 14, 14); -fx-background-radius: 12; -fx-padding: 10;"/>
                </StackPane>
            </StackPane>

            <!-- Área Lateral Direita -->
            <VBox prefWidth="200" minWidth="200" maxWidth="200" spacing="16" style="-fx-background-color: rgb(15, 14, 14); -fx-background-radius: 12; -fx-padding: 10;">
                <Label text="Clientes Pendentes" style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Separator
                    prefHeight="3"
                    style="-fx-background-color: white;"
                    maxWidth="Infinity"
                    prefWidth="Infinity"
                />
                <ScrollPane
                    fx:id="scrollPendentes"
                    fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="NEVER"
                    style="
                        -fx-background: rgb(43, 40, 40);
                        -fx-border-color: rgba(197, 130, 64, 0.86);
                        -fx-border-width: 2;
                        -fx-background-radius: 16;
                        -fx-border-radius: 16; 
                        -fx-padding: 4; 
                        -fx-focus-color: transparent;
                        -fx-faint-focus-color: transparent;
                        "
                    VBox.vgrow="ALWAYS"
                >
                    <VBox
                        fx:id="caixaClientesPendentes"
                        spacing="0"
                        alignment="TOP_LEFT"
                        prefWidth="180"
                    />
                </ScrollPane>
                <Separator
                    prefHeight="3"
                    style="-fx-background-color: white;"
                    maxWidth="Infinity"
                    prefWidth="Infinity"
                />
                <Label fx:id="relogioLabel"
                       style="-fx-font-size: 40px; -fx-font-weight: 900; -fx-text-fill: white; -fx-alignment: center;"
                       alignment="CENTER"
                       prefWidth="200"
                />
            </VBox>      
        </HBox>
    </center>
    
</BorderPane>
