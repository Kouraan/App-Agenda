<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.PaginaPrincipalController"
            style="-fx-background-color: #f0f0f0;">
    
    <!-- Área Superior com informações do usuário e navegação -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Label text="App Agenda" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
            <Button text="Logout" onAction="#handleLogout" 
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    
    <!-- Área Principal dividida em 3 colunas -->
    <center>
        <HBox spacing="5" style="-fx-padding: 10;">
            
            <!-- Área Lateral Esquerda -->
            <VBox prefWidth="200" style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 2; -fx-padding: 10;">
                <Label text="Área Lateral Esquerda" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-alignment: center;"/>
                <Label text="(Em desenvolvimento)" style="-fx-font-size: 12px; -fx-text-fill: gray;"/>
            </VBox>
            
            <!-- Área Central - Calendário Semanal -->
            <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 2; -fx-padding: 10;">
                
                <!-- Cabeçalho da semana -->
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 10 0;">
                    <Button fx:id="todayBtn" text="Today" onAction="#handleToday" 
                            style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Button fx:id="semanaAnteriorBtn" text="◀" onAction="#semanaAnterior" 
                            style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Button fx:id="proximaSemanaBtn" text="▶" onAction="#proximaSemana" 
                            style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="semanaLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ToggleButton fx:id="diaToggle" text="Dia"/>
                    <ToggleButton fx:id="semanaToggle" text="Semana" selected="true"/>
                    <ToggleButton fx:id="mesToggle" text="Mês"/>
                </HBox>
                
                <!-- Grade do calendário -->
                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                    <GridPane fx:id="calendarioGrid" hgap="1" vgap="1" 
                              style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7;"/>
                </ScrollPane>
                
            </VBox>
            
            <!-- Área Lateral Direita -->
            <VBox prefWidth="200" style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 2; -fx-padding: 10;">
                <Label text="Área Lateral Direita" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-alignment: center;"/>
                <Label text="(Em desenvolvimento)" style="-fx-font-size: 12px; -fx-text-fill: gray;"/>
            </VBox>
            
        </HBox>
    </center>
    
</BorderPane>
