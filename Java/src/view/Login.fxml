<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="stackPaneRoot" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.LoginController"
           alignment="CENTER"
           style="-fx-background-image: url('/fundo.jpg'); -fx-background-size: 100% 100%; -fx-background-position: center center; -fx-background-repeat: no-repeat;">
    <VBox spacing="8" alignment="TOP_LEFT" style="-fx-padding: 100 0 0 80;">
        <Label text="LOGIN"
               style="-fx-text-fill: white; -fx-font-size: 56px; -fx-font-weight: 900; -fx-padding: 0 0 0 60;"/>
        <Label fx:id="errorLabel" textFill="rgb(128, 26, 15)" visible="false"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"
               text="Utilizador ou password incorretos"/>
        <GridPane hgap="10" vgap="10">
            <Label text="Username:"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="usernameField" prefWidth="140" maxWidth="140"
                       style="-fx-background-color: white; -fx-border-color: transparent; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-width: 2; -fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Password :"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <PasswordField fx:id="passwordField" prefWidth="140" maxWidth="140"
                           style="-fx-background-color: white; -fx-border-color: transparent; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-width: 2; -fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
        <HBox alignment="TOP_LEFT" style="-fx-padding: 0 0 0 120;">
              <Button fx:id="entrarBtn" text="Entrar" onAction="#handleLogin" maxWidth="120"
                      style="-fx-background-color: rgb(36, 43, 141); -fx-background-radius: 12; -fx-border-color: white; -fx-border-radius: 12; -fx-border-width: 2; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>
</StackPane>