<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.DetalheClienteController"
            prefWidth="500" prefHeight="540"
            style="-fx-background-color: rgb(15, 14, 14); -fx-border-width: 0;">
    <center>
        <StackPane>
            <!-- VISUALIZAÇÃO -->
            <VBox fx:id="visualBox" alignment="TOP_CENTER" spacing="4" style="-fx-padding: 48 32 32 32;">
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 8 0;">
                    <Button fx:id="btnEditar" text="Editar"
                        style="-fx-background-color: rgb(60, 60, 60); -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 6 18 6 18;"
                        visible="true" managed="true"/>
                </HBox>
                <GridPane fx:id="gridVisual"
                        style="-fx-background-color: rgb(43, 40, 40); -fx-border-width: 0; -fx-padding: 24 24 10 24; -fx-background-radius: 18;"
                        prefWidth="Infinity" maxWidth="Infinity">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140" maxWidth="180" halignment="LEFT"/>
                        <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                    </columnConstraints>
                    <!-- Linhas preenchidas dinamicamente pelo controller -->
                </GridPane>
            </VBox>
            <!-- MODO EDIÇÃO -->
            <VBox fx:id="editBox" alignment="TOP_CENTER" spacing="18" visible="false" managed="false" style="-fx-padding: 48 32 32 32;">
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 8 0;">
                    <Button fx:id="btnVoltarVisual" text="Editar"
                        style="-fx-background-color: rgb(60, 60, 60); -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 6 18 6 18;"
                        focusTraversable="false"
                        visible="false" managed="false"/>
                </HBox>
                <CheckBox fx:id="semanalCheck" text="Cliente Semanal" alignment="CENTER" style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                <VBox alignment="TOP_CENTER" spacing="10" style="-fx-padding: 12 0 0 0;" maxWidth="360">
                    <Label text="Nome:" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                    <TextField fx:id="nomeField" maxWidth="360" style="-fx-background-color: white; -fx-background-radius: 12; -fx-boder-width: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"/>
                    <Label fx:id="nomeErrorLabel" text="" style="-fx-text-fill: rgb(128, 26, 15); -fx-font-size: 12px;" visible="false" managed="false"/>
                    <Label text="Telefone:" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                    <TextField fx:id="telefoneField" maxWidth="360" style="-fx-background-color: white; -fx-background-radius: 12; -fx-boder-width: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"/>
                    <Label fx:id="telefoneErrorLabel" text="" style="-fx-text-fill: rgb(128, 26, 15); -fx-font-size: 12px;" visible="false" managed="false"/>
                    <Label text="Dia da Semana:" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                    <ComboBox fx:id="diaSemanaCombo" promptText="Dia da Semana" maxWidth="360" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-width: 0;"/>
                    <Label text="Hora do Corte:" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                    <ComboBox fx:id="horaCorteCombo" promptText="Hora do Corte" maxWidth="360" style="-fx-background-color: white; -fx-background-radius: 12; -fx-boder-width: 0;"/>
                    <Label fx:id="horaCorteErrorLabel" text="" style="-fx-text-fill: rgb(128, 26, 15); -fx-font-size: 12px;" visible="false" managed="false"/>
                    <HBox spacing="8" alignment="CENTER">
                        <Label text="Faltas:" style="-fx-text-fill: white; -fx-font-size: 20px;"/>
                        <Button fx:id="btnMenosFalta" text="-" style="-fx-background-color: white; -fx-font-size: 13px;"/>
                        <Label fx:id="faltasLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 20px;"/>
                        <Button fx:id="btnMaisFalta" text="+" style="-fx-background-color: white; -fx-font-size: 13px;"/>
                    </HBox>
                    <Label fx:id="geralErrorLabel" text="" style="-fx-text-fill: rgb(128, 26, 15); -fx-font-size: 13px;" visible="false" managed="false"/>
                </VBox>
            </VBox>
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="BOTTOM_RIGHT" spacing="16" style="-fx-padding: 0 32 48 32;">
            <Button fx:id="btnSalvar" text="Salvar"
                style="-fx-background-color: rgb(36, 43, 141); -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 6 24 6 24;"
                visible="false" managed="false"/>
            <Button fx:id="btnApagar" text="Apagar"
                style="-fx-background-color: rgb(128, 26, 15); -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 6 24 6 24;"
                visible="true" managed="true"/>
            <Button fx:id="btnSair" text="Sair"
                style="-fx-background-color: rgb(60, 60, 60); -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 6 24 6 24;"/>
        </HBox>
    </bottom>
</BorderPane>